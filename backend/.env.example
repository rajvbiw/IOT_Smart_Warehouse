# ==============================================================================
# IoT Smart Warehouse Management System - Backend Environment Configuration Template
# ==============================================================================

# Server Network Settings
PORT=5000
SOCKET_CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Security & Session (JWT Tokens)
# Note: In production, use high-entropy 256-bit cryptographically secure strings.
JWT_SECRET=CHANGE_ME_MIN_32_CHARACTERS_LONG_SECRET_KEY
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARACTERS_LONG_REFRESH_KEY

# MySQL Database Configuration (Sequelize)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=warehouse_iot
DB_USER=root
DB_PASSWORD=password

# Time Series Database (InfluxDB v2)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=admin-token-12345
INFLUX_ORG=warehouse-org
INFLUX_BUCKET=warehouse_sensors

# Redis Cache Service
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Local MQTT Broker (Mosquitto)
MQTT_BROKER_URL=mqtt://localhost:1883

# Device Telemetry Simulation
# Set to 'false' to disable local simulated sensors publishing MQTT payloads
SIMULATE_DEVICES=true

# AWS Cloud Integration settings
# Note: Leave AWS credentials empty or set to 'CHANGE_ME' to trigger the system's
# automated local storage fallback pipeline for uploads and mock publishing.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS S3 Reports Storage Bucket
S3_BUCKET=warehouse-iot-reports

# AWS SNS Topic ARN for Alerts routing
AWS_SNS_TOPIC_ARN=

# AWS IoT Core Endpoint (used for cloud syncing)
AWS_IOT_ENDPOINT=
